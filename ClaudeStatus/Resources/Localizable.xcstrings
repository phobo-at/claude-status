{
  "sourceLanguage" : "en",
  "strings" : {
    "Access to the Claude Code login was denied." : {
      "comment" : "Error shown when the user denies the Keychain dialog.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf den Claude-Code-Login wurde nicht erlaubt."
          }
        }
      }
    },
    "When you connect, macOS asks for Keychain access. Claude Code renews its login a few times a day, and macOS drops that permission every time it does — so the dialog comes back. Claude Status raises it only at app launch and when you ask for it, never from a background update. The login is kept in memory only, never stored or logged." : {
      "comment" : "First-run consent text on the connect screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verbinden fragt macOS nach dem Schlüsselbundzugriff. Claude Code erneuert seinen Login mehrmals täglich, und macOS verwirft die Freigabe jedes Mal — der Dialog kommt also wieder. Claude Status löst ihn nur beim App-Start und auf deine Anforderung hin aus, nie aus einer Hintergrundaktualisierung. Der Login bleibt nur im Arbeitsspeicher, wird nie gespeichert oder protokolliert."
          }
        }
      }
    },
    "All models" : {
      "comment" : "Title of the weekly all-models limit row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Modelle"
          }
        }
      }
    },
    "Cached data" : {
      "comment" : "Banner shown while the popover displays the last cached snapshot.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherter Stand"
          }
        }
      }
    },
    "Check again" : {
      "comment" : "Button that re-checks the login after the user ran claude auth login.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut prüfen"
          }
        }
      }
    },
    "Claude is temporarily unavailable (HTTP %lld)." : {
      "comment" : "Error for a 5xx response. Placeholder is the HTTP status code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ist vorübergehend nicht erreichbar (HTTP %lld)."
          }
        }
      }
    },
    "Claude received too many refreshes." : {
      "comment" : "Error for HTTP 429, the account-scoped rate limit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude hat zu viele Aktualisierungen erhalten."
          }
        }
      }
    },
    "Claude returned no usage limits." : {
