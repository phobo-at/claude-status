        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüsselbundzugriff erlauben"
          }
        }
      }
    },
    "Claude Code renewed its login. macOS needs your permission again." : {
      "comment" : "Banner shown when the rotated token cannot be read without a Keychain dialog.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code hat seinen Login erneuert. macOS braucht erneut deine Freigabe."
          }
        }
      }
    },
    "Claude Code renewed its login, and macOS dropped this app’s Keychain permission along with it. The numbers stay frozen until you allow one more read — nothing happens in the background." : {
      "comment" : "Explanation on the reauthorization screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code hat seinen Login erneuert, und macOS hat die Schlüsselbund-Freigabe dieser App gleich mit verworfen. Die Werte bleiben eingefroren, bis du einen weiteren Lesezugriff erlaubst — im Hintergrund passiert nichts."
          }
        }
      }
    },
    "Claude usage, current session: %@ used, Keychain permission needed" : {
      "comment" : "Menu bar accessibility label while the numbers are frozen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude-Nutzung, aktuelle Sitzung: %@ verwendet, Schlüsselbund-Freigabe nötig"
          }
        }
      }
    },
    "Keychain permission needed" : {
      "comment" : "Title of the reauthorization screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüsselbund-Freigabe nötig"
          }
        }
      }
    },
    "Claude usage, current session: %@ used, Claude sign-in required" : {
      "comment" : "Menu bar accessibility label while the login itself has expired.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude-Nutzung, aktuelle Sitzung: %@ verwendet, Claude-Anmeldung erforderlich"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
